---
import { brand, footerNav } from '@/config/brand';
import { PIXELS } from '@/config/site';
import { url } from '@/lib/url';
import Logo from './Logo.astro';
import LabelList from './LabelList.astro';

const hasPixels = Boolean(PIXELS.metaPixelId || PIXELS.gadsId);
const socials = [
  { key: 'linkedin', label: 'LinkedIn', href: brand.social.linkedin, path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9V21h-4V9Z' },
  { key: 'instagram', label: 'Instagram', href: brand.social.instagram, path: 'M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4Zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0ZM12 3.6c2.7 0 3 0 4.1.1 2.7.1 4 1.4 4.1 4.1.1 1.1.1 1.4.1 4.1s0 3-.1 4.1c-.1 2.7-1.4 4-4.1 4.1-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-2.7-.1-4-1.4-4.1-4.1C3.7 15 3.6 14.7 3.6 12s0-3 .1-4.1c.1-2.7 1.4-4 4.1-4.1 1.1-.1 1.4-.2 4.2-.2Z' },
  { key: 'facebook', label: 'Facebook', href: brand.social.facebook, path: 'M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.6 1.6-1.6h1.7V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.3H7.3v3.2h2.8V21h3.4Z' },
].filter((s) => s.href);
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-brand-200 bg-brand-50">
  <div class="container-rp grid gap-12 py-14 lg:grid-cols-[1.2fr_2fr]">
    <div class="grid content-start gap-5">
      <a href={`${brand.mainSiteUrl}/`} class="w-fit" aria-label="Review Plus – naar de homepage">
        <Logo size={26} wordmark />
      </a>
      <form class="grid gap-2" data-newsletter novalidate>
        <label for="nb-email" class="text-sm font-medium">Abonneer op onze nieuwsbrief</label>
        <div class="flex gap-2">
          <input id="nb-email" name="email" type="email" autocomplete="email" required placeholder="jij@bedrijf.nl" class="input !min-h-[44px] !rounded-full" aria-describedby="nb-status" />
          <button type="submit" class="btn btn-primary !min-h-[44px] shrink-0">Aanmelden</button>
        </div>
        <p id="nb-status" class="hint" aria-live="polite"></p>
      </form>
      {socials.length > 0 && (
        <ul class="flex gap-2" aria-label="Social media">
          {socials.map((s) => (
            <li><a href={s.href} rel="noopener" target="_blank" class="flex size-10 items-center justify-center rounded-full border border-brand-200 bg-white text-brand-600 hover:bg-brand-100" aria-label={s.label}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
            </a></li>
          ))}
        </ul>
      )}
    </div>

    <nav aria-label="Footer" class="grid grid-cols-2 gap-8 sm:grid-cols-3">
      {footerNav.map((col) => (
        <div>
          <h2 class="mb-3 text-sm font-semibold !text-ink">{col.title}</h2>
          <ul class="grid gap-2 text-sm text-ink-soft">
            {col.links.map((l) => (
              <li><a class="hover:text-brand-600" href={'internal' in l && l.internal ? url(l.href) : l.href}>{l.label}</a></li>
            ))}
            {col.title === 'Wettelijk' && hasPixels && (
              <li><button type="button" data-open-consent class="cursor-pointer text-left hover:text-brand-600">Cookie-instellingen</button></li>
            )}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="border-t border-brand-200">
    <div class="container-rp flex flex-wrap items-center gap-x-6 gap-y-3 py-5">
      <p class="text-sm text-muted">Onderdeel van AIO Plus:</p>
      <LabelList plek="footer" />
    </div>
  </div>
  <div class="border-t border-brand-200">
    <div class="container-rp flex flex-wrap items-center justify-between gap-3 py-5 text-sm text-muted">
      <p>© {year} Reviewplus.io. Alle rechten voorbehouden.</p>
      <a href={brand.demoBookingUrl} target="_blank" rel="noopener" data-track="demo_klik" data-track-plek="footer" class="font-medium text-brand-600 hover:underline">Boek een demo</a>
    </div>
  </div>
</footer>

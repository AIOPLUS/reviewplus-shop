---
/**
 * Offerte aanvragen voor de live reviewteller. Verstuurt als `request_type: contact` naar de Make-webhook, zodat de
 * bestaande contactroute (5b: mail aan support@ met Reply-To + kopie aan de klant) hem verwerkt zonder Make te wijzigen.
 * De gekozen teller staat in het bericht. Zie docs/REVIEWTELLER.md.
 */
import { LEAD } from '@/config/site';
import { brand } from '@/config/brand';
import { PLATFORMEN, type ReviewPlatform } from '@/lib/reviewplatformen';

interface Props {
  platform?: ReviewPlatform;
  /** Id van de teller waarvan de keuze overgenomen wordt. */
  kiezer?: string;
}
const { platform = 'Google', kiezer = 'kiezer' } = Astro.props;
---
<section id="offerte" class="scroll-mt-24" aria-labelledby="offerte-titel">
  <form
    class="card grid gap-5 p-5 md:p-8"
    data-offerte
    data-kiezer-id={kiezer}
    data-webhook={LEAD.webhookUrl}
    data-turnstile={LEAD.turnstileSiteKey}
    data-fallback-email={LEAD.fallbackEmail}
    novalidate
  >
    <div>
      <h2 id="offerte-titel" class="text-2xl md:text-3xl">Vraag een offerte aan</h2>
      <p class="mt-2 text-ink-soft">De prijs volgt nog. Laat weten welke teller je wilt, dan sturen we je binnen één werkdag een voorstel.</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      <div class="field">
        <label for="of-platform">Platform</label>
        <select id="of-platform" name="platform" class="input">
          {PLATFORMEN.map((p) => <option value={p} selected={p === platform}>{p}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="of-cijfers">Cijfers</label>
        <select id="of-cijfers" name="cijfers" class="input">
          <option value="5">5 cijfers (tot 99.999)</option>
          <option value="7">7 cijfers (tot 9.999.999)</option>
        </select>
      </div>
      <div class="field">
        <label for="of-aantal">Aantal tellers</label>
        <input id="of-aantal" name="aantal" type="number" min="1" max="50" value="1" inputmode="numeric" class="input" aria-describedby="of-aantal-msg" />
        <p id="of-aantal-msg" class="error" data-msg></p>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="field">
        <label for="of-voornaam">Voornaam <span class="req" aria-hidden="true">*</span></label>
        <input id="of-voornaam" name="voornaam" class="input" autocomplete="given-name" required aria-describedby="of-voornaam-msg" />
        <p id="of-voornaam-msg" class="error" data-msg></p>
      </div>
      <div class="field">
        <label for="of-achternaam">Achternaam <span class="req" aria-hidden="true">*</span></label>
        <input id="of-achternaam" name="achternaam" class="input" autocomplete="family-name" required aria-describedby="of-achternaam-msg" />
        <p id="of-achternaam-msg" class="error" data-msg></p>
      </div>
      <div class="field">
        <label for="of-bedrijf">Bedrijfsnaam <span class="req" aria-hidden="true">*</span></label>
        <input id="of-bedrijf" name="bedrijf" class="input" autocomplete="organization" required aria-describedby="of-bedrijf-msg" />
        <p id="of-bedrijf-msg" class="error" data-msg></p>
      </div>
      <div class="field">
        <label for="of-email">E-mailadres <span class="req" aria-hidden="true">*</span></label>
        <input id="of-email" name="email" type="email" class="input" autocomplete="email" required aria-describedby="of-email-msg" />
        <p id="of-email-msg" class="error" data-msg></p>
      </div>
      <div class="field sm:col-span-2">
        <label for="of-telefoon">Telefoonnummer <span class="text-muted font-normal">(optioneel)</span></label>
        <input id="of-telefoon" name="telefoon" type="tel" class="input" autocomplete="tel" />
      </div>
      <div class="field sm:col-span-2">
        <label for="of-bericht">Opmerking <span class="text-muted font-normal">(optioneel)</span></label>
        <textarea id="of-bericht" name="bericht" rows="3" class="input" placeholder="Bijvoorbeeld: voor drie vestigingen, of waar de teller komt te staan"></textarea>
      </div>
    </div>

    <div class="hidden" aria-hidden="true">
      <label for="of-hp">Laat dit veld leeg</label>
      <input id="of-hp" name="hp_website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="field">
      <label class="check !font-normal">
        <input type="checkbox" id="of-akkoord" name="akkoord" required aria-describedby="of-akkoord-msg" />
        <span>Ik ga akkoord met de <a class="text-brand-600 underline" href={`${brand.mainSiteUrl}/privacy-policy`} target="_blank" rel="noopener">privacyverklaring<span class="sr-only"> (opent in een nieuw tabblad)</span></a>. <span class="req" aria-hidden="true">*</span></span>
      </label>
      <p id="of-akkoord-msg" class="error" data-msg></p>
    </div>

    <div data-turnstile-slot class="min-h-[65px]" hidden={!LEAD.turnstileSiteKey}></div>

    <div class="flex flex-wrap items-center gap-4">
      <button type="submit" class="btn btn-primary btn-lg">Verstuur aanvraag</button>
      <p class="text-sm text-muted">Vrijblijvend. Je krijgt een kopie in je mailbox.</p>
    </div>
    <p class="error" role="alert" data-offerte-fout></p>
  </form>

  <div class="card grid gap-2 p-6 md:p-8" data-offerte-klaar hidden tabindex="-1">
    <h2 class="text-2xl">Bedankt, je aanvraag is binnen</h2>
    <p class="text-ink-soft">We sturen je binnen één werkdag een voorstel. Een kopie van je aanvraag staat in je mailbox.</p>
  </div>
</section>

<script>
  import { track } from '@/lib/client/analytics';

  // Window.turnstile is gedeclareerd in lib/client/flow.ts.
  const form = document.querySelector<HTMLFormElement>('[data-offerte]');
  if (form) {
    const d = form.dataset;
    const veld = (naam: string) => form.elements.namedItem(naam) as HTMLInputElement;
    const waarde = (naam: string) => veld(naam).value.trim();
    const melding = (naam: string, tekst: string) => {
      const el = veld(naam);
      const msg = document.getElementById(`${el.id}-msg`);
      if (msg) msg.textContent = tekst;
      if (tekst) el.setAttribute('aria-invalid', 'true');
      else el.removeAttribute('aria-invalid');
    };

    // Keuze uit de tellerkiezer overnemen: nu (de kiezer kan al gestart zijn, bijvoorbeeld met ?platform=airbnb)
    // en bij elke wijziging daarna.
    const neemOver = (platform?: string, cijfers?: string | number) => {
      if (platform) veld('platform').value = platform;
      if (cijfers) veld('cijfers').value = String(cijfers);
    };
    const kast = document.getElementById(d.kiezerId ?? '');
    neemOver(kast?.dataset.platform, kast?.dataset.cijfers);
    window.addEventListener('reviewteller:keuze', (e) => {
      const { platform, cijfers, id } = (e as CustomEvent<{ platform: string; cijfers: number; id: string }>).detail;
      if (id === d.kiezerId) neemOver(platform, cijfers);
    });

    // Turnstile pas laden als iemand het formulier gebruikt.
    let widgetId: string | undefined;
    const laadTurnstile = () => {
      const slot = form.querySelector<HTMLElement>('[data-turnstile-slot]');
      if (!d.turnstile || !slot || widgetId !== undefined) return;
      const render = () => {
        if (window.turnstile && widgetId === undefined) {
          widgetId = window.turnstile.render(slot, { sitekey: d.turnstile, language: 'nl', appearance: 'interaction-only', action: 'offerte' });
        }
      };
      if (window.turnstile) return render();
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = render;
      document.head.append(s);
    };
    form.addEventListener('focusin', laadTurnstile, { once: true });

    form.querySelectorAll('input, textarea').forEach((el) => el.addEventListener('input', () => melding((el as HTMLInputElement).name, '')));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fout = form.querySelector<HTMLElement>('[data-offerte-fout]')!;
      fout.textContent = '';
      if (waarde('hp_website')) return;

      const verplicht: [string, string][] = [
        ['voornaam', 'Vul je voornaam in.'],
        ['achternaam', 'Vul je achternaam in.'],
        ['bedrijf', 'Vul je bedrijfsnaam in.'],
      ];
      let eerste: HTMLElement | null = null;
      for (const [naam, tekst] of verplicht) {
        const leeg = !waarde(naam);
        melding(naam, leeg ? tekst : '');
        if (leeg) eerste ??= veld(naam);
      }
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(waarde('email'));
      melding('email', emailOk ? '' : 'Vul een geldig e-mailadres in, bijvoorbeeld naam@bedrijf.nl.');
      if (!emailOk) eerste ??= veld('email');
      const aantal = Number(waarde('aantal'));
      const aantalOk = Number.isInteger(aantal) && aantal >= 1 && aantal <= 50;
      melding('aantal', aantalOk ? '' : 'Kies een aantal van 1 tot 50.');
      if (!aantalOk) eerste ??= veld('aantal');
      const akkoord = veld('akkoord').checked;
      melding('akkoord', akkoord ? '' : 'Ga akkoord met de privacyverklaring om je aanvraag te versturen.');
      if (!akkoord) eerste ??= veld('akkoord');
      if (eerste) return eerste.focus();

      const knop = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      knop.disabled = true;
      knop.textContent = 'Bezig met versturen…';
      try {
        laadTurnstile();
        let token: string | null = null;
        if (d.turnstile) {
          for (let i = 0; i < 20 && !token; i++) {
            token = window.turnstile?.getResponse(widgetId) || null;
            if (!token) await new Promise((r) => setTimeout(r, 300));
          }
          if (!token) throw new Error('turnstile');
        }
        const cijfers = waarde('cijfers');
        const bericht = [
          'Offerteaanvraag live reviewteller (shop)',
          `Platform: ${waarde('platform')}`,
          `Cijfers: ${cijfers} (tot ${cijfers === '7' ? '9.999.999' : '99.999'})`,
          `Aantal tellers: ${aantal}`,
          waarde('bericht') ? `\nOpmerking:\n${waarde('bericht')}` : '',
        ].filter(Boolean).join('\n');
        const res = await fetch(d.webhook!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            request_type: 'contact',
            lead_source: 'shop-reviewteller',
            submitted_at: new Date().toISOString(),
            pagina: location.href,
            contact: { voornaam: waarde('voornaam'), achternaam: waarde('achternaam'), email: waarde('email'), telefoon: waarde('telefoon') },
            bedrijf: { naam: waarde('bedrijf') },
            plan: null,
            bericht,
            offerte: { product: 'live-reviewteller', platform: waarde('platform'), cijfers: Number(cijfers), aantal },
            turnstile_token: token,
          }),
        });
        if (!res.ok) throw new Error(String(res.status));
        track('offerte_verzonden', { platform: waarde('platform'), cijfers });
        form.hidden = true;
        const klaar = form.parentElement!.querySelector<HTMLElement>('[data-offerte-klaar]')!;
        klaar.hidden = false;
        klaar.focus();
      } catch (err) {
        window.turnstile?.reset(widgetId);
        fout.textContent =
          err instanceof Error && err.message === 'turnstile'
            ? 'De beveiligingscontrole is nog niet afgerond. Staat er een vakje "Ik ben geen robot"? Vink het aan en klik daarna opnieuw op versturen.'
            : `Versturen is niet gelukt. Probeer het opnieuw of mail ons via ${d.fallbackEmail}.`;
      } finally {
        knop.disabled = false;
        knop.textContent = 'Verstuur aanvraag';
      }
    });
  }
</script>

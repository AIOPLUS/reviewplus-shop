---
/**
 * Productfoto uit src/assets/products (AVIF/WebP met srcset via astro:assets).
 * - Uitgeknipte foto (transparant): op een zacht blauw podium met slagschaduw.
 * - Gewone foto: volledig zichtbaar op een achtergrond in de randkleur van de foto.
 * Zonder foto: eenvoudige SVG-illustratie.
 */
import { Picture } from 'astro:assets';
import type { Product } from '@/lib/catalog';
import { edgeColor, isCutout, productImage } from '@/lib/images';

interface Props {
  product: Pick<Product, 'type' | 'naam' | 'afbeeldingen'>;
  index?: number;
  /** Direct een bestandsnaam kiezen in plaats van product.afbeeldingen[index]. */
  file?: string;
  alt?: string;
  sizes?: string;
  eager?: boolean;
  fit?: 'contain' | 'cover';
  /** Ruimte rond een uitgeknipte foto (percentage van het kader). */
  padding?: 'sm' | 'md' | 'lg';
  /** Podium-achtergrond tonen achter een uitgeknipte foto (uit = transparant, bv. op een gekleurd blok). */
  stage?: boolean;
  class?: string;
}

const {
  product, index = 0, file, alt, sizes = '(min-width: 1200px) 560px, (min-width: 810px) 45vw, 100vw', eager = false, fit = 'contain',
  padding = 'md', stage = true, class: cls = '',
} = Astro.props;

const name = file ?? product.afbeeldingen[index];
const img = productImage(name);
const cutout = img && name ? await isCutout(name) : false;
const bg = img && name && !cutout ? await edgeColor(name) : undefined;
const pad = { sm: 'p-[4%]', md: 'p-[8%]', lg: 'p-[12%]' }[padding];
const isTotem = product.type === 'totem';
const widths = img ? [400, 700, 1000, 1400].filter((w) => w <= img.width * 1.1) : [];
---
{img && cutout ? (
  <div class={`rp-stage flex h-full w-full items-center justify-center ${stage ? '' : 'rp-stage--bare'} ${pad} ${cls}`}>
    <Picture src={img} alt={alt ?? product.naam} formats={['avif', 'webp']} widths={widths} sizes={sizes}
      loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} pictureAttributes={{ class: 'block h-full w-full' }}
      class="rp-cutout h-full w-full object-contain" />
  </div>
) : img ? (
  <div class={`flex h-full w-full items-center justify-center ${cls}`} style={`background:${bg}`}>
    <Picture src={img} alt={alt ?? product.naam} formats={['avif', 'webp']} widths={widths} sizes={sizes}
      loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} pictureAttributes={{ class: 'block h-full w-full' }}
      class={`h-full w-full ${fit === 'contain' ? 'object-contain' : 'object-cover'}`} />
  </div>
) : isTotem ? (
  <svg viewBox="0 0 400 300" role="img" aria-label={`Illustratie: ${product.naam}`} class={`h-full w-full ${cls}`}>
    <rect width="400" height="300" fill="#EFF4FF" />
    <path d="M140 258 170 58h60l30 200z" fill="#1818FF" />
  </svg>
) : (
  <svg viewBox="0 0 400 300" role="img" aria-label={`Illustratie: ${product.naam}`} class={`h-full w-full ${cls}`}>
    <rect width="400" height="300" fill="#EFF4FF" />
    <g transform="rotate(4 200 150)"><rect x="108" y="84" width="200" height="126" rx="14" fill="#1818FF" /></g>
  </svg>
)}

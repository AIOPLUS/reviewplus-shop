---
import { url } from '@/lib/url';
import BrandCorners from './BrandCorners.astro';
interface Props {
  title?: string;
  text?: string;
  sector?: string;
}
const {
  title = 'Vraag vandaag nog je gratis NFC-kaarten aan',
  text = 'Gratis voor bedrijven in Nederland en België, ook gratis verzonden. Je zit nergens aan vast.',
  sector,
} = Astro.props;
const q = sector ? `?sector=${sector}` : '';
---
<section class="container-rp py-16">
  <div class="relative grid justify-items-center gap-5 overflow-hidden rounded-[var(--radius-panel)] border border-brand-200 bg-white px-6 pb-36 pt-14 text-center md:pb-24">
    <p class="text-sm font-medium tracking-wide text-brand-600">Laat je review achter. <span class="text-ink">Tap. Review.</span></p>
    <h2 class="relative max-w-2xl text-3xl md:text-4xl">{title}</h2>
    <p class="relative max-w-xl text-ink-soft">{text}</p>
    <a href={url(`/aanvragen${q}`)} class="btn btn-primary btn-lg relative">Vraag gratis aan</a>
    <BrandCorners />
  </div>
</section>

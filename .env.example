# ── Domein ──────────────────────────────────────────────────────────────
# Fase 1: https://shop.reviewplus.io + "/"   ·   Fase 2: https://www.reviewplus.io + "/shop"
SITE_URL=https://shop.reviewplus.io
SHOP_BASE_PATH=/

# ── Aanvragen ───────────────────────────────────────────────────────────
# make (standaard) | web3forms | formspree
PUBLIC_LEAD_PROVIDER=make
# Make.com custom webhook (of Formspree endpoint bij provider=formspree)
PUBLIC_LEAD_WEBHOOK_URL=
# Alleen nodig bij provider=web3forms
PUBLIC_WEB3FORMS_ACCESS_KEY=
# Cloudflare Turnstile site key (de secret key staat alleen in Make)
PUBLIC_TURNSTILE_SITE_KEY=
# Make-webhook die { "remaining": 873 } teruggeeft (voorraadteller gratis sets). Leeg = toon het maximum.
PUBLIC_STOCK_URL=

# ── Analytics (cookieloos, geen toestemming nodig) ──────────────────────
# plausible | umami | leeg = uit
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_DOMAIN=shop.reviewplus.io
PUBLIC_ANALYTICS_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# ── Advertentiepixels (alleen na toestemming; leeg = niet laden) ────────
PUBLIC_META_PIXEL_ID=
PUBLIC_GADS_ID=
PUBLIC_GADS_CONVERSION_LABEL=
